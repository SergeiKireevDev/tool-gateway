# Copy to .env and fill in. Real environment variables take precedence over this file.

# --- Network -------------------------------------------------------------------
# GATEWAY_HOST=127.0.0.1
# GATEWAY_PORT=7420
# URL you open in the browser. Google redirects back to <GATEWAY_PUBLIC_URL>/auth/google/callback,
# so it must match the redirect URI registered in Google Cloud exactly.
GATEWAY_PUBLIC_URL=http://localhost:7420

# --- Storage -------------------------------------------------------------------
# GATEWAY_DATA_DIR=./data
# GATEWAY_KEY_FILE=~/.local-gateway/master.key

# --- Admin sign-in with Google ---------------------------------------------------
# Google Cloud Console → APIs & Services → Credentials → Create credentials → OAuth client ID
#   Application type: Web application
#   Authorized redirect URI: http://localhost:7420/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated Google accounts allowed to administer the gateway. Nobody else can sign in.
GATEWAY_ADMIN_EMAILS=

# --- Gmail sign-in (optional) -----------------------------------------------------
# "Sign in with Google" on Gmail accounts uses the Google client above (enable the Gmail API in its
# project): Google redirects back to the gateway. Only set these for a dedicated client instead,
# of type Desktop app, whose 127.0.0.1 redirect address is pasted back. Without any client, Gmail
# access tokens can be pasted.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# --- Client scripts (not read by the gateway server) ----------------------------
# Member key (gwm_…) used by local scripts to request short-lived session keys through
# POST /api/sessions. It cannot call tools or the admin API by itself.
# GATEWAY_MEMBER_KEY=

# Agent launchpad: IPv4 address of the microVM bridge (e.g. 172.30.0.1). The gateway also listens
# there, serving only the proxy and /api/session to agent VMs. Leave empty to disable agents.
GATEWAY_VM_HOST=

# Agent launchpad: firecracker (needs GATEWAY_VM_HOST and vmd) or local-unsafe (development only,
# no isolation). Leave empty to turn the launchpad off. See docs/launchpad.md.
LAUNCHPAD_VM_DRIVER=
