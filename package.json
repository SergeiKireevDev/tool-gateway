{
  "name": "local-gateway",
  "version": "1.0.0",
  "description": "Local gateway that brokers scoped, short-lived access to third-party tools (GitHub, monday.com)",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server/index.ts",
    "build": "tsc -p tsconfig.build.json && next build web",
    "start": "NODE_ENV=production node dist/server/index.js",
    "admin:reset-token": "tsx src/server/cli/resetAdminToken.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test"
  },
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "cookie": "^2.0.1",
    "express": "^5.2.1",
    "graphql": "^16.14.2",
    "libsodium-wrappers": "^0.8.4",
    "next": "^16.3.6",
    "openid-client": "^6.8.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.3.6",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/libsodium-wrappers": "^0.7.14",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "globals": "^17.12.0",
    "jose": "^6.2.12",
    "prettier": "^3.9.9",
    "supertest": "^7.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
