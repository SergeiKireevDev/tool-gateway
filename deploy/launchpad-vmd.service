[Unit]
Description=Agent launchpad VM daemon (Firecracker)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStartPre=/opt/local-gateway/deploy/vm-host-setup.sh
ExecStart=/usr/bin/node /opt/local-gateway/dist/vmd/index.js
# The gateway's group may use the socket.
Environment=VMD_SOCKET=/run/launchpad/vmd.sock
Environment=VMD_SOCKET_GID=1000
Restart=on-failure

[Install]
WantedBy=multi-user.target
